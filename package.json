{
  "name": "cipher-library",
  "version": "1.0.0",
  "private": true,
  "description": "Локальная библиотека шифров с иерархическими тегами",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "predev": "npm run db:migrate",
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite client",
    "build": "vite build client",
    "prestart": "npm run db:migrate",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc -p client && tsc -p server",
    "test": "tsx --test shared/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "6.19.3",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.4",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true
  }
}
